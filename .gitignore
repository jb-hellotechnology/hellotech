# Ignore everything by default
*

# Allow directories to be traversed so the rules below can match
!*/

# Allow only these:
!/assets/
!/assets/**
!/found/
!/found/**
!/styles.css
!/sitemap.php
!/admin/
!/admin/templates/
!/admin/templates/**

# Never track config (credentials)
/found/config.php

# Allow this file
!/.gitignore

# Never track OS junk, even inside allowed folders
.DS_Store
