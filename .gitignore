# Ignore everything by default
*

# Allow directories to be traversed so the rules below can match
!*/

# Allow only these:
!/assets/
!/assets/**
!/found/
!/found/**
!/styles.css
!/sitemap.php
!/llms.txt
!/admin/
!/admin/templates/
!/admin/templates/**

!/admin/addons/apps/hello_found/
!/admin/addons/apps/hello_found/**

# Never track config (credentials)
/found/config.php
/admin/addons/apps/hello_found/config.php

# Allow this file
!/.gitignore
!/.cpanel.yml

# Never track OS junk, even inside allowed folders
.DS_Store