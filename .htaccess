# Perch Runway
RewriteEngine On

# Canonical host: send www.hellotechnology.co.uk to the non-www HTTPS site (permanent).
# Must come before every other rule so /found/ and Perch URLs are covered too.
RewriteCond %{HTTP_HOST} ^www\.hellotechnology\.co\.uk$ [NC]
RewriteRule ^(.*)$ https://hellotechnology.co.uk/$1 [R=301,L]

# Strip trailing slashes from Perch page URLs (/contact/ -> /contact) to avoid duplicates.
# /found/ and /admin/ are real directories and are left alone.
RewriteCond %{REQUEST_URI} !^/(found|admin)(/|$)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Serve the standalone /found/ landing page directly — bypass Perch Runway
DirectoryIndex index.php index.html
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^found(/|$) - [END]
</IfModule>

# Serve the XML sitemap (generated by sitemap.php) at /sitemap.xml
RewriteRule ^sitemap\.xml$ /sitemap.php [L]

# ==========================================================================
# Hello Technology: redirects for legacy URLs (generated 6 November 2026)
# Place this block ABOVE any existing /articles/ -> /blog/ rule, so each old
# URL resolves in a single hop instead of chaining into a 404.
# ==========================================================================
<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Old WordPress archive pages (tags, categories, author, pagination): 132 URLs
RewriteRule ^(articles|blog)/(tag|category|author|page)(/.*)?$ https://hellotechnology.co.uk/blog [R=301,L,NC]

# 2. Old service and section pages mapped to current service pages
