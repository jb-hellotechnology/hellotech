# Perch Runway
RewriteEngine On

# Canonical host: send www.hellotechnology.co.uk to the non-www HTTPS site (permanent).
# Must come before every other rule so /found/ and Perch URLs are covered too.
RewriteCond %{HTTP_HOST} ^www\.hellotechnology\.co\.uk$ [NC]
RewriteRule ^(.*)$ https://hellotechnology.co.uk/$1 [R=301,L]

# Strip trailing slashes from Perch page URLs (/contact/ -> /contact) to avoid duplicates.
# /found/ and /admin/ are real directories and are left alone.
RewriteCond %{REQUEST_URI} !^/(found|admin)(/|$)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Serve the standalone /found/ landing page directly — bypass Perch Runway
DirectoryIndex index.php index.html
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^found(/|$) - [END]
</IfModule>

# Serve the XML sitemap (generated by sitemap.php) at /sitemap.xml
RewriteRule ^sitemap\.xml$ /sitemap.php [L]

# Redirect old /articles/ URLs to /blog/ (permanent)
RewriteRule ^articles/(.*)$ /blog/$1 [R=301,L]

RewriteCond %{REQUEST_URI} !^/admin
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule .* /admin/core/runway/start.php [L]

# ----------------------------------------------------------------------
# Browser caching for static assets (LiteSpeed honours mod_expires)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # Images & fonts rarely change — cache hard
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/gif              "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType font/woff              "access plus 1 year"
  # CSS/JS — shorter, since /styles.css has no version string (see note)
  ExpiresByType text/css               "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# ----------------------------------------------------------------------
# Compression (LiteSpeed usually does this itself; harmless if so)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript \
    application/javascript application/json image/svg+xml application/xml
</IfModule> 


# ----------------------------------------------------------------------
# Security headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # CSP in REPORT-ONLY mode first: nothing is blocked, but violations show in the
  # browser console. Once the console is clean on key pages, rename the header to
  # Content-Security-Policy to enforce. Not applied to /admin (Perch needs inline/eval).
  <If "%{REQUEST_URI} !~ m#^/admin#">
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.usefathom.com https://meetings.brevo.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://meetings.brevo.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://cdn.usefathom.com https://meetings.brevo.com https://meet.brevo.com https://api.websitecarbon.com; frame-src https://meet.brevo.com https://meetings.brevo.com; form-action 'self'; base-uri 'self'; frame-ancestors 'self'"
  </If>
</IfModule>
